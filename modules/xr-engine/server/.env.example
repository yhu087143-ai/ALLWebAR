# 服务监听地址
XR_BACKEND_HOST=127.0.0.1
XR_BACKEND_PORT=8787

# 本地 3D 生成：指向各自的仓库/项目根目录
# 留空则表示该提供方不可用（前端会显示"不可用"）
INSTANTMESH_DIR=
TRIPOSR_DIR=

# 云端提供方（Tripo3D）
TRIPO_API_KEY=
TRIPO_API_BASE=https://api.tripo3d.ai/v2/openapi

# USDZ 转换用的 Blender 可执行文件路径（iOS AR 降级需要）
BLENDER_PATH=

# 生成产物的存放目录
XR_OUTPUT_DIR=./outputs
