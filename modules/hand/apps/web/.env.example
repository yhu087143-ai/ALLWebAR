# Database
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/project1xr?schema=public"

# Auth (NextAuth.js)
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"

# Meshy AI API
MESHY_API_KEY="your-meshy-api-key"
MESHY_API_URL="https://api.meshy.ai/openapi/v2"

# LLM API (SiliconFlow)
LLM_API_KEY="your-llm-api-key"
LLM_API_URL="https://api.siliconflow.cn/v1"
LLM_MODEL="deepseek-ai/DeepSeek-V3.2"

# Redis
REDIS_URL="redis://localhost:6379"

# Storage (Alibaba OSS)
OSS_REGION="oss-cn-hangzhou"
OSS_ACCESS_KEY="your-oss-access-key"
OSS_SECRET_KEY="your-oss-secret-key"
OSS_BUCKET="project1xr-assets"
OSS_ENDPOINT="https://oss-cn-hangzhou.aliyuncs.com"
